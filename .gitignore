config.json
config.local.json
.env
.env.*

# ─── Generated payloads ─────────────────────────────────
builds/*
!builds/.gitkeep

# ─── Runtime logs ────────────────────────────────────
logs/*
!logs/.gitkeep

# ─── ngrok binary────────────────────────────────────────
ngrok
ngrok-stable-*
ngrok.zip

# ─── Editor / IDE ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
